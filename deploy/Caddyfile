# /etc/caddy/Caddyfile — 화면(빌드본)과 API 를 같은 HTTPS 주소로 제공한다.
# {$이름} 은 /etc/hanwha-dx/hanwha-dx.env, /etc/hanwha-dx/admin-auth.env 의 값이다 (caddy 서비스 drop-in 이 읽는다).
# 인증서는 Caddy 가 자동으로 받고 갱신한다 (Let's Encrypt, 실패 시 ZeroSSL).

(dx_site) {
	encode zstd gzip

	# API 와 상태 확인은 uvicorn 으로. uvicorn 은 127.0.0.1 에만 열려 있어 외부에서 직접 접근할 수 없다.
	@backend path /api/* /health
	handle @backend {
		reverse_proxy 127.0.0.1:8000
	}

	# 그 밖은 frontend 빌드본 (3D 뷰어 iframe·GLB 포함). 같은 origin 이라 iframe 메시지 검사도 그대로 통과한다.
	handle {
		root * /opt/hanwha-dx/www
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/hanwha-dx.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# 관람객 주소 — QR 로 배포한다. 서버(DEPLOY_MODE=public)가 변경 요청을 403 으로 막는다.
{$PUBLIC_HOST} {
	# 외부에서 관리자 헤더를 흉내 내지 못하게 지운다.
	request_header -X-Admin-Token
	request_body {
		max_size 1MB
	}
	import dx_site
}

# 관리자 시연 주소 — Basic 인증을 통과한 요청에만 관리자 헤더를 붙인다.
{$ADMIN_HOST} {
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASS_HASH}
	}
	request_header X-Admin-Token {$ADMIN_TOKEN}
	request_body {
		max_size 30MB
	}
	import dx_site
}
