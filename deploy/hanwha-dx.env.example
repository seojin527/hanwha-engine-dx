# 서버의 /etc/hanwha-dx/hanwha-dx.env 로 복사해 쓰는 예시. 실제 값이 든 파일은 Git 에 넣지 않는다.
# server_setup.sh 가 처음 한 번 이 파일을 복사하고 ADMIN_TOKEN 을 무작위 값으로 채운다.

# ---------------------------------------------------------------- 공개 주소
# 관람객 주소와 관리자 주소 (https:// 없이 호스트 이름만). Caddy 가 두 이름 모두 인증서를 받는다.
#   무료 예: dx.203-0-113-10.sslip.io / admin.203-0-113-10.sslip.io (서버 IP 를 - 로 이은 이름)
#   DuckDNS 예: hanwha-dx.duckdns.org / admin.hanwha-dx.duckdns.org
PUBLIC_HOST=dx.CHANGE-ME.sslip.io
ADMIN_HOST=admin.CHANGE-ME.sslip.io
# Let's Encrypt 만료 알림을 받을 메일 (선택)
ACME_EMAIL=

# ---------------------------------------------------------------- 체험 모드 (backend/deploy_guard.py)
# public: 관람객 주소는 조회만 가능 (변경 요청은 서버가 403). 관리자 주소만 변경 가능.
DEPLOY_MODE=public
# 관리자 주소의 Caddy 가 Basic 인증 통과 후 붙이는 헤더 값. 공개 주소에서는 Caddy 가 이 헤더를 지운다.
ADMIN_TOKEN=CHANGE-ME
WRITE_RATE_PER_MIN=60
OCR_MAX_ACTIVE=1
OCR_MAX_PER_HOUR=10

# ---------------------------------------------------------------- 실행 앱 · OCR
# 발표 서버($12·2GB)는 OCR 을 실행하지 않는다. 실측: OCR 1건 약 2.1GB + 백엔드 약 1.2GB.
# OCR_ENABLED=0  관리자 요청이어도 업로드·OCR 실행·샘플 OCR 저장을 서버가 403 으로 막는다 (deploy_guard.py).
# APP_MODULE     app:app (OCR 라우트·작업자 없음). app_auto:app 은 OCR_ENABLED=1 일 때만 deploy.sh 가 허용한다.
OCR_ENABLED=0
APP_MODULE=app:app

# ---------------------------------------------------------------- 데이터 위치 (코드 폴더 밖 → 재배포해도 유지)
DX_STORAGE_DIR=/srv/hanwha-dx/storage
DX_VECTOR_DB_DIR=/srv/hanwha-dx/vector_db
DX_DATA_DIR=/srv/hanwha-dx/data
DX_LOG_DIR=/srv/hanwha-dx/logs

# ---------------------------------------------------------------- OCR 실행 환경 (OCR_ENABLED=1, APP_MODULE=app_auto:app 일 때만 사용)
OCR_PYTHON=/opt/hanwha-dx/venv-ocr/bin/python
OCR_TESSDATA=/usr/share/tesseract-ocr/5/tessdata

# 임베딩 모델(E5) 캐시. 처음 시작할 때 Hugging Face 에서 한 번 받는다 (약 0.5GB).
HF_HOME=/srv/hanwha-dx/cache/huggingface
